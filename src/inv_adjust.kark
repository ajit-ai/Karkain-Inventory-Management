// Karkain Inventory Management - Round 2 adjustments, valuation and
// reconciliation. Self-contained module: reads data/r2_inventory.dat, rebuilds
// state from scratch on every run (safe to repeat), and persists to
// data/r2_inv_state.dat / data/r2_inv_report.dat. Round 1 sources, state and
// output are untouched.

func r2_find(state, kind, key) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == kind) {
            if (f[1] == key) { return state[i] }
        }
        i = i + 1
    }
    return ""
}

func r2_find_stock(state, code, wh) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "STOCK") {
            if (f[1] == code) {
                if (f[2] == wh) { return state[i] }
            }
        }
        i = i + 1
    }
    return ""
}

func r2_qty(state, code, wh) {
    let rec = r2_find_stock(state, code, wh)
    if (rec == "") { return 0 }
    return int(split(rec, "|")[3])
}

func r2_set_stock(state, code, wh, qty) {
    let rec = "STOCK|" + code + "|" + wh + "|" + str(qty)
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "STOCK") {
            if (f[1] == code) {
                if (f[2] == wh) { push(out, rec); replaced = 1 }
                else { push(out, state[i]) }
            } else { push(out, state[i]) }
        } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func r2_set_count(state, code, wh, counted) {
    let rec = "COUNT|" + code + "|" + wh + "|" + str(counted)
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "COUNT") {
            if (f[1] == code) {
                if (f[2] == wh) { push(out, rec); replaced = 1 }
                else { push(out, state[i]) }
            } else { push(out, state[i]) }
        } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func r2_count(state, kind) {
    let n = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == kind) { n = n + 1 }
        i = i + 1
    }
    return n
}

func r2_total_qty(state, code) {
    let total = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "STOCK") {
            if (f[1] == code) { total = total + int(f[3]) }
        }
        i = i + 1
    }
    return total
}

func r2_persist(path, state) {
    let out = ""
    let i = 0
    while (i < len(state)) {
        out = out + state[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

public func inv2_run() {
    let reasons = "DAMAGE|CORRECTION|FOUND|RETURN"
    let cmds = split(readFile("data/r2_inventory.dat"), "\n")
    let state = []
    let report = ""
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = trim(f[0])
            if (op == "SKU") {
                let code = trim(f[1])
                let name = trim(f[2])
                if (r2_find(state, "SKU", code) == "") { push(state, "SKU|" + code + "|" + name) }
                let msg = "SKU " + code + " " + name
                print("INV2 " + msg)
                report = report + "INV2 " + msg + "\n"
            }
            if (op == "UNIT_COST") {
                let code = trim(f[1])
                let cost = int(trim(f[2]))
                if (r2_find(state, "SKU", code) == "") {
                    push(state, "ERROR|" + code + "|unknown_sku|-")
                    print("INV2 UNIT_COST " + code + " FAIL unknown_sku")
                } else {
                    push(state, "UNIT_COST|" + code + "|" + str(cost))
                    let msg = "UNIT_COST " + code + " " + str(cost)
                    print("INV2 " + msg)
                    report = report + "INV2 " + msg + "\n"
                }
            }
            if (op == "RECEIVE") {
                let code = trim(f[1])
                let qty = int(trim(f[2]))
                let wh = trim(f[3])
                if (r2_find(state, "SKU", code) == "") {
                    push(state, "ERROR|" + code + "|unknown_sku|-")
                    print("INV2 RECEIVE " + code + " FAIL unknown_sku")
                } else if (qty < 1) {
                    push(state, "ERROR|" + code + "|bad_qty|-")
                    print("INV2 RECEIVE " + code + " FAIL bad_qty")
                } else {
                    let now = r2_qty(state, code, wh) + qty
                    state = r2_set_stock(state, code, wh, now)
                    let msg = "RECEIVE " + code + " " + str(qty) + " " + wh + " -> " + str(now)
                    print("INV2 " + msg)
                    report = report + "INV2 " + msg + "\n"
                }
            }
            if (op == "ADJUST") {
                let code = trim(f[1])
                let wh = trim(f[2])
                let qty = int(trim(f[3]))
                let reason = trim(f[4])
                if (r2_find(state, "SKU", code) == "") {
                    push(state, "ERROR|" + code + "|unknown_sku|-")
                    print("INV2 ADJUST " + code + " FAIL unknown_sku")
                } else if (contains(reasons, reason) == 0) {
                    push(state, "ERROR|" + code + "|invalid_reason|-")
                    print("INV2 ADJUST " + code + " FAIL invalid_reason=" + reason)
                } else if (qty == 0) {
                    push(state, "ERROR|" + code + "|bad_qty|-")
                    print("INV2 ADJUST " + code + " FAIL bad_qty")
                } else {
                    let now = r2_qty(state, code, wh) + qty
                    if (now < 0) {
                        push(state, "ERROR|" + code + "|negative_stock|-")
                        print("INV2 ADJUST " + code + " FAIL negative_stock would_be=" + str(now))
                    } else {
                        state = r2_set_stock(state, code, wh, now)
                        push(state, "ADJ|" + code + "|" + wh + "|" + str(qty) + "|" + reason)
                        let msg = "ADJUST " + code + " " + wh + " " + str(qty) + " " + reason + " -> " + str(now)
                        print("INV2 " + msg)
                        report = report + "INV2 " + msg + "\n"
                    }
                }
            }
            if (op == "COUNT") {
                let code = trim(f[1])
                let wh = trim(f[2])
                let counted = int(trim(f[3]))
                if (r2_find(state, "SKU", code) == "") {
                    push(state, "ERROR|" + code + "|unknown_sku|-")
                    print("INV2 COUNT " + code + " FAIL unknown_sku")
                } else {
                    state = r2_set_count(state, code, wh, counted)
                    let msg = "COUNT " + code + " " + wh + " counted=" + str(counted)
                    print("INV2 " + msg)
                    report = report + "INV2 " + msg + "\n"
                }
            }
            if (op == "RECONCILE") {
                let k = 0
                while (k < len(state)) {
                    let c = split(state[k], "|")
                    if (c[0] == "COUNT") {
                        let book = r2_qty(state, c[1], c[2])
                        let counted = int(c[3])
                        let variance = counted - book
                        let msg = "RECONCILE " + c[1] + " " + c[2] + " book=" + str(book) + " counted=" + str(counted) + " variance=" + str(variance)
                        print("INV2 " + msg)
                        report = report + "INV2 " + msg + "\n"
                    }
                    k = k + 1
                }
            }
            if (op == "VALUE") {
                let total = 0
                let k = 0
                while (k < len(state)) {
                    let s = split(state[k], "|")
                    if (s[0] == "SKU") {
                        let costrec = r2_find(state, "UNIT_COST", s[1])
                        let cost = 0
                        if (costrec != "") { cost = int(split(costrec, "|")[2]) }
                        let qty = r2_total_qty(state, s[1])
                        let value = qty * cost
                        total = total + value
                        let msg = "VALUE " + s[1] + " qty=" + str(qty) + " cost=" + str(cost) + " value=" + str(value)
                        print("INV2 " + msg)
                        report = report + "INV2 " + msg + "\n"
                    }
                    k = k + 1
                }
                let msg = "VALUE_TOTAL value=" + str(total) + " skus=" + str(r2_count(state, "SKU"))
                print("INV2 " + msg)
                report = report + "INV2 " + msg + "\n"
            }
            if (op == "REPORT") {
                let total = 0
                let k = 0
                while (k < len(state)) {
                    let s = split(state[k], "|")
                    if (s[0] == "STOCK") {
                        total = total + int(s[3])
                        let msg = "STOCK " + s[1] + " " + s[2] + " qty=" + s[3]
                        print("INV2 " + msg)
                        report = report + "INV2 " + msg + "\n"
                    }
                    k = k + 1
                }
                let msg = "REPORT locations=" + str(r2_count(state, "STOCK")) + " total_units=" + str(total)
                print("INV2 " + msg)
                report = report + "INV2 " + msg + "\n"
            }
        }
        i = i + 1
    }
    r2_persist("data/r2_inv_state.dat", state)
    r2_persist("data/r2_inv_report.dat", split(report, "\n"))
    print("INV2_OK skus=" + str(r2_count(state, "SKU")) + " locations=" + str(r2_count(state, "STOCK")) + " adjustments=" + str(r2_count(state, "ADJ")) + " counts=" + str(r2_count(state, "COUNT")) + " errors=" + str(r2_count(state, "ERROR")))
}
